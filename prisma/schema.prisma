generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String   @unique
  password  String
  otp       String?
  otpExpiry DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rules {
  id                 Int      @id @default(autoincrement())
  ruleNumber         String   @unique
  rule               String
  category           String
  status             String
  userId             Int
}

model Strategy {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  strategyType    String
  instrumentType  String
  description     String   @db.Text
  timeFrame       Json
  entryConditions Json
  indicatorsUsed  Json
  userId          Int
}

model Trade {
  id             Int      @id @default(autoincrement())
  entryDate      String?
  fromDate       String?
  toDate         String?
  tradeType      String?
  instrumentType String?
  position       String?
  capitalUsed    Float?
  entryPrice     Float?
  exitPrice      Float?
  qty            Int?
  riskReward     Float?
  totalPnl       Float?
  tradeStatus    String?
  result         String?
  strategy       String?
  rulesFollowed  Json?
  notes          String?
  tradeImg       String?
  userId         Int
}